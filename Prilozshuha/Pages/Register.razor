@page "/register"
@using Prilozshuha.ApiRequests
@using Prilozshuha.ApiRequests.Models
@inject ApiRequestService ApiRequests
@inject NavigationManager Navigation

<PageTitle>Регистрация</PageTitle>

<div class="card" style="max-width: 450px; margin: 40px auto; padding: 32px;">
    <h2 class="text-center mb-4">✨ Создание аккаунта</h2>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert alert-danger">@message</div>
    }

    <div class="form-group">
        <label class="form-label">Имя</label>
        <input class="form-control" @bind="name" placeholder="Как вас зовут?" />
    </div>
    <div class="form-group">
        <label class="form-label">О себе</label>
        <input class="form-control" @bind="description" placeholder="Пару слов о себе" />
    </div>
    <div class="form-group">
        <label class="form-label">Email</label>
        <input class="form-control" @bind="email" placeholder="name@example.com" />
    </div>
    <div class="form-group">
        <label class="form-label">Пароль</label>
        <input type="password" class="form-control" @bind="password" placeholder="Минимум 6 символов" />
    </div>

    <button class="btn btn-primary w-full mt-4" @onclick="Create">Зарегистрироваться</button>

    <div class="text-center mt-4">
        <a href="/login" style="color: var(--primary); text-decoration: none; font-weight: 500;">Уже есть аккаунт? Войти →</a>
    </div>
</div>

@code {
    private string name = "";
    private string description = "";
    private string email = "";
    private string password = "";
    private string message = "";

    private async Task Create()
    {
        var model = new ReqDataUser
        {
            Name = name,
            Description = description,
            Email = email,
            Password = password
        };
        var result = await ApiRequests.CreateNewUserAndLoginAsync(model);
        if (result.status)
        {
            Navigation.NavigateTo("/login");
        }
        else
        {
            message = result.message;
            StateHasChanged();
        }
    }
}