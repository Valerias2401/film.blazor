@using Prilozshuha.ApiRequests
@using Prilozshuha.ApiRequests.Services
@using Prilozshuha.ApiRequests.Models
@inject ChatService ChatService
@inject UserService UserService
@inject IJSRuntime JS
@implements IDisposable

<div class="chat-wrapper">
    <div class="chat-header flex justify-between items-center p-4">
        <div>
            <h5 class="mb-0">💬 Чат</h5>
            <small class="text-muted">@MovieTitle</small>
        </div>
        <button class="btn-close" @onclick="CloseChat">×</button>
    </div>

    <div class="chat-body" id="chatBody">
        @if (!ChatService.Messages.Any())
        {
            <div class="empty-state text-center py-5">
                <div class="icon mb-2">👋</div>
                <h5>Пока пусто</h5>
                <p class="text-muted">Напиши первое сообщение!</p>
            </div>
        }
        else
        {
            @foreach (var msg in ChatService.Messages)
            {
                <div class="message-row @(msg.isOwn ? "own" : "other")">
                    <div class="message-bubble">
                        <div class="message-meta flex justify-between">
                            <strong>@msg.fromUserName</strong>
                            <span>@msg.createdAt.ToString("HH:mm")</span>
                        </div>
                        @if (!string.IsNullOrEmpty(msg.photoUrl))
                        {
                            <img src="@msg.photoUrl" class="msg-img" />
                        }
                        <div class="message-text">@msg.content</div>
                        <div class="message-actions">
                            @if ((UserService.IsAdmin || msg.isOwn) && (!isEditing || editingId != msg.messageId))
                            {
                                <span class="action-icon" @onclick="() => StartEdit(msg)">✏️</span>
                                <span class="action-icon text-danger" @onclick="() => DeleteMsg(msg.messageId)">🗑️</span>
                            }
                            @if (msg.isEdited)
                            {
                                <span class="edited-tag">(изм.)</span>
                            }
                        </div>
                        @if (isEditing && editingId == msg.messageId)
                        {
                            <div class="edit-box p-2 mt-2">
                                <input @bind="editText" class="form-control form-control-sm mb-2" />
                                <div class="flex gap-2">
                                    <button class="btn btn-sm btn-success" @onclick="() => SaveEdit(msg.messageId)">💾</button>
                                    <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">❌</button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="chat-footer flex items-center gap-2 p-3">
        <input type="text" class="form-control" placeholder="Сообщение..." @bind="newMessage" @onkeypress="HandleEnter" />
        <input type="text" class="form-control photo-input" placeholder="📷 URL" @bind="newPhotoUrl" />
        <button class="btn-send" @onclick="SendMessage">🚀</button>
    </div>
</div>

<style>
    .chat-wrapper {
        display: flex;
        flex-direction: column;
        height: 100%;
        background: #fff;
        border-radius: 24px;
        overflow: hidden;
    }

    .chat-header {
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
    }

        .chat-header h5 {
            margin: 0;
            font-size: 1.1rem;
        }

    .btn-close {
        background: rgba(255,255,255,0.2);
        border: none;
        color: white;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

        .btn-close:hover {
            background: rgba(255,255,255,0.3);
        }

    .chat-body {
        flex: 1;
        overflow-y: auto;
        padding: 16px;
        background: #f8fafc;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .empty-state {
        color: var(--text-muted);
    }

        .empty-state .icon {
            font-size: 3rem;
        }

    .message-row {
        display: flex;
    }

        .message-row.own {
            justify-content: flex-end;
        }

        .message-row.other {
            justify-content: flex-start;
        }

    .message-bubble {
        max-width: 75%;
        padding: 12px 16px;
        border-radius: 18px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
    }

    .message-row.own .message-bubble {
        background: #1e293b;
        color: white;
        border-bottom-right-radius: 4px;
    }

    .message-row.other .message-bubble {
        background: white;
        color: #1e293b;
        border: 1px solid #e2e8f0;
        border-bottom-left-radius: 4px;
    }

    .message-meta {
        font-size: 0.75rem;
        opacity: 0.8;
        margin-bottom: 6px;
        display: flex;
        justify-content: space-between;
    }

    .message-row.own .message-meta {
        color: #94a3b8;
    }

    .message-row.other .message-meta {
        color: #64748b;
    }

    .message-text {
        word-break: break-word;
        line-height: 1.4;
        font-size: 0.95rem;
    }

    .message-row.own .message-text {
        color: white;
    }

    .message-row.other .message-text {
        color: #1e293b;
    }

    .msg-img {
        max-width: 100%;
        border-radius: 10px;
        margin: 8px 0;
        display: block;
    }

    .message-actions {
        margin-top: 6px;
        display: flex;
        gap: 8px;
        font-size: 0.8rem;
        opacity: 0.7;
    }

    .message-row.own .message-actions {
        color: #94a3b8;
    }

    .message-row.other .message-actions {
        color: #64748b;
    }

    .message-bubble:hover .message-actions {
        opacity: 1;
    }

    .action-icon {
        cursor: pointer;
    }

    .edited-tag {
        font-size: 0.7rem;
        font-style: italic;
        opacity: 0.7;
        margin-left: 5px;
    }

    .edit-box {
        background: rgba(255,255,255,0.9);
        border-radius: 12px;
    }

    .chat-footer {
        background: white;
        border-top: 1px solid var(--border);
    }

    .photo-input {
        width: 100px;
        font-size: 0.85rem;
        padding: 8px 12px;
    }

    .btn-send {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        font-size: 1.2rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
    }

        .btn-send:hover {
            transform: scale(1.1);
        }

    .p-2 {
        padding: 8px;
    }

    .p-3 {
        padding: 12px;
    }

    .p-4 {
        padding: 16px;
    }

    .mb-0 {
        margin-bottom: 0;
    }

    .mb-2 {
        margin-bottom: 8px;
    }

    .py-5 {
        padding: 20px 0;
    }

    .text-center {
        text-align: center;
    }

    .text-muted {
        color: var(--text-muted);
    }

    .text-danger {
        color: var(--danger);
    }

    .flex {
        display: flex;
    }

    .items-center {
        align-items: center;
    }

    .justify-between {
        justify-content: space-between;
    }

    .gap-2 {
        gap: 8px;
    }
</style>

@code {
    [Parameter] public int MovieId { get; set; }
    [Parameter] public string MovieTitle { get; set; } = "Фильм";
    [Parameter] public EventCallback OnClose { get; set; }

    private string newMessage = "";
    private string newPhotoUrl = "";
    private bool isEditing = false;
    private int editingId = 0;
    private string editText = "";
    private bool isSending = false;
    private bool isInitialized = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            ChatService.OnMessagesUpdated += OnMessagesUpdated;

            if (UserService.CurrentUser == null)
            {
                Console.WriteLine("CurrentUser is null, cannot connect to chat");
                return;
            }

            ChatService.SetCurrentUserId(UserService.CurrentUser.id_User);
            await ChatService.Connect();

            await LoadChat();
            isInitialized = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in OnInitializedAsync: {ex.Message}");
        }
    }

    private async Task LoadChat()
    {
        try
        {
            await ChatService.LoadMovieMessages(MovieId);
            await ChatService.JoinMovieChat(MovieId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in LoadChat: {ex.Message}");
        }
    }

    private void OnMessagesUpdated()
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(newMessage)) return;
        if (isSending) return;

        isSending = true;

        try
        {
            if (UserService.CurrentUser == null)
            {
                Console.WriteLine("CurrentUser is null, cannot send message");
                return;
            }

            if (!ChatService.IsConnected)
            {
                Console.WriteLine("Reconnecting to SignalR...");
                ChatService.SetCurrentUserId(UserService.CurrentUser.id_User);
                await ChatService.Connect();
                await Task.Delay(500);
            }

            await ChatService.SendMessage(MovieId, null, newMessage, string.IsNullOrWhiteSpace(newPhotoUrl) ? null : newPhotoUrl);
            newMessage = "";
            newPhotoUrl = "";
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Send error: {ex.Message}");
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await SendMessage();
    }

    private void StartEdit(MessageModel msg)
    {
        isEditing = true;
        editingId = msg.messageId;
        editText = msg.content;
    }

    private void CancelEdit()
    {
        isEditing = false;
        editingId = 0;
        editText = "";
    }

    private async Task SaveEdit(int id)
    {
        await ChatService.EditMessage(id, editText);
        CancelEdit();
    }

    private async Task DeleteMsg(int id)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Удалить сообщение?"))
            await ChatService.DeleteMessage(id);
    }

    private async Task CloseChat()
    {
        ChatService.ClearMessages();
        await OnClose.InvokeAsync();
    }

    public void Dispose()
    {
        ChatService.OnMessagesUpdated -= OnMessagesUpdated;
    }
}